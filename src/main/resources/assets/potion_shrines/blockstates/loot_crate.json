{
  "multipart": [
    {
      "apply": {"model": "potion_shrines:block/loot_crate/box"}
    },
    {
      "when": {"rarity": "common"},
      "apply": {"model": "potion_shrines:block/loot_crate/common_gem"}
    },
    {
      "when": {"rarity": "uncommon"},
      "apply": {"model": "potion_shrines:block/loot_crate/uncommon_gem"}
    },
    {
      "when": {"rarity": "rare"},
      "apply": {"model": "potion_shrines:block/loot_crate/rare_gem"}
    },
    {
      "when": {"rarity": "epic"},
      "apply": {"model": "potion_shrines:block/loot_crate/epic_gem"}
    },
    {
      "when": {"rarity": "legendary"},
      "apply": {"model": "potion_shrines:block/loot_crate/legendary_gem"}
    }
  ]
}
